@model tp03.Models.Produto
@using System.Globalization

@{
    ViewData["Title"] = "Excluir Produto";
    var culturaBrasileira = new CultureInfo("pt-BR");
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm border-danger" style="border-top: 4px solid #dc3545 !important;">

            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                <div>
                    <h5 class="mb-0 fw-bold text-danger">Confirmação de Exclusão</h5>
                    <span class="text-muted small">Esta operação removerá o produto permanentemente da base de dados.</span>
                </div>
            </div>

            <div class="card-body p-4">
                <p class="fs-6 mb-4 text-secondary">
                    Tem certeza de que deseja remover o item <strong>@Model.Nome</strong> (Código #@Model.Id)?
                </p>

                <div class="bg-light p-3 rounded border mb-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted small text-uppercase">Nome:</dt>
                        <dd class="col-sm-8 fw-bold text-dark">@Model.Nome</dd>

                        <dt class="col-sm-4 text-muted small text-uppercase">Preço:</dt>
                        <dd class="col-sm-8 fw-bold text-primary">@Model.Preco.ToString("C2", culturaBrasileira)</dd>

                        <dt class="col-sm-4 text-muted small text-uppercase">Estoque Atual:</dt>
                        <dd class="col-sm-8 fw-bold text-dark">@Model.QuantidadeEmEstoque unidades</dd>

                        <dt class="col-sm-4 text-muted small text-uppercase">Descrição:</dt>
                        <dd class="col-sm-8 text-muted small mb-0">@Model.Descricao</dd>
                    </dl>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-arrow-left me-1"></i> Cancelar e Voltar
                        </a>
                        <button type="submit" class="btn btn-danger px-4 shadow-sm">
                            <i class="bi bi-trash-fill me-1"></i> Confirmar Exclusão
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>