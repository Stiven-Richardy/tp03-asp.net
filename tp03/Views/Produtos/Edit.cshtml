@model tp03.Models.Produto

@{
    ViewData["Title"] = "Editar Dados do Produto";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0" style="border-top: 4px solid #0A3D62 !important;">

            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0 fw-bold" style="color: #0A3D62;">
                        <i class="bi bi-pencil-square me-2"></i> Atualização de Cadastro
                    </h5>
                    <span class="text-muted small">Modificação das especificações do item #@Model.Id</span>
                </div>
                <span class="badge bg-light text-dark border">Cód. #@Model.Id</span>
            </div>

            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 mb-4" role="alert"></div>

                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label fw-bold text-secondary"></label>
                        <input asp-for="Nome" class="form-control" placeholder="Ex: Monitor Gamer LED 27 IPS" autocomplete="off" />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descricao" class="form-label fw-bold text-secondary"></label>
                        <textarea asp-for="Descricao" class="form-control" rows="3" placeholder="Insira os detalhes técnicos atualizados do produto"></textarea>
                        <span asp-validation-for="Descricao" class="text-danger small"></span>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label asp-for="Preco" class="form-label fw-bold text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted">R$</span>
                                <input asp-for="Preco" class="form-control" type="number" step="0.01" min="0.01" />
                            </div>
                            <span asp-validation-for="Preco" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="QuantidadeEmEstoque" class="form-label fw-bold text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-boxes"></i></span>
                                <input asp-for="QuantidadeEmEstoque" class="form-control" type="number" min="0" />
                            </div>
                            <span asp-validation-for="QuantidadeEmEstoque" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-x-circle me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary px-4 shadow-sm">
                            <i class="bi bi-check-lg me-1"></i> Salvar Alterações
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}