@model IEnumerable<tp03.Models.Produto>
@using System.Globalization

@{
    ViewData["Title"] = "Catálogo de Produtos";
    var culturaBrasileira = new CultureInfo("pt-BR");
}

<div class="card shadow-sm border-0">
    <div class="card-body p-4">

        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <div>
                <h5 class="card-title mb-1 text-secondary fw-bold">Estoque de Produtos</h5>
                <p class="text-muted small mb-0">Controle integrado de itens cadastrados e disponibilidade em pátio.</p>
            </div>
            <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 px-3 py-2">
                <i class="bi bi-plus-lg"></i>
                <span>Novo Produto</span>
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary">
                    <tr>
                        <th style="width: 8%;">Cód.</th>
                        <th style="width: 25%;">Nome do Produto</th>
                        <th style="width: 30%;">Descrição</th>
                        <th style="width: 12%;">Preço</th>
                        <th style="width: 13%;">Estoque</th>
                        <th class="text-end" style="width: 12%;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                Nenhum produto cadastrado no momento. Utilize o botão acima para incluir o primeiro item.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-muted">#@item.Id</td>
                                <td class="fw-semibold text-dark">@item.Nome</td>
                                <td class="text-muted small text-truncate" style="max-width: 220px;" title="@item.Descricao">
                                    @item.Descricao
                                </td>
                                <td class="fw-bold text-dark">
                                    @item.Preco.ToString("C2", culturaBrasileira)
                                </td>
                                <td>
                                    @if (item.QuantidadeEmEstoque == 0)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-2 py-1">
                                            <i class="bi bi-x-circle me-1"></i> Esgotado
                                        </span>
                                    }
                                    else if (item.QuantidadeEmEstoque <= 5)
                                    {
                                        <span class="badge bg-warning bg-opacity-25 text-dark border border-warning px-2 py-1">
                                            <i class="bi bi-exclamation-triangle me-1"></i> @item.QuantidadeEmEstoque un. (Baixo)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i> @item.QuantidadeEmEstoque unidades
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Visualizar Detalhes">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Editar Produto">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Excluir Produto">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>