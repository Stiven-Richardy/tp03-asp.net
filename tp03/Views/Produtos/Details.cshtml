@model tp03.Models.Produto
@using System.Globalization

@{
    ViewData["Title"] = "Ficha Técnica do Produto";
    var culturaBrasileira = new CultureInfo("pt-BR");
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0" style="border-top: 4px solid #0A3D62 !important;">

            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                <div>
                    <h5 class="mb-0 fw-bold" style="color: #0A3D62;">
                        <i class="bi bi-box-seam me-2"></i> @Model.Nome
                    </h5>
                    <span class="text-muted small">Código de Identificação: #@Model.Id</span>
                </div>
                <div>
                    @if (Model.QuantidadeEmEstoque == 0)
                    {
                        <span class="badge bg-danger px-3 py-2">Esgotado</span>
                    }
                    else if (Model.QuantidadeEmEstoque <= 5)
                    {
                        <span class="badge bg-warning text-dark px-3 py-2">Estoque Crítico</span>
                    }
                    else
                    {
                        <span class="badge bg-success px-3 py-2">Em Estoque</span>
                    }
                </div>
            </div>

            <div class="card-body p-4">
                <div class="row g-4">

                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded border">
                            <span class="text-muted small d-block mb-1">Preço Unitário de Venda</span>
                            <h3 class="fw-bold text-primary mb-0">
                                @Model.Preco.ToString("C2", culturaBrasileira)
                            </h3>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded border">
                            <span class="text-muted small d-block mb-1">Volume em Estoque</span>
                            <h3 class="fw-bold text-dark mb-0">
                                @Model.QuantidadeEmEstoque <span class="fs-6 fw-normal text-muted">unidades disponíveis</span>
                            </h3>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold text-secondary mb-2">Descrição Completa</label>
                        <div class="p-3 rounded border bg-white text-secondary" style="min-height: 120px; line-height: 1.6;">
                            @Model.Descricao
                        </div>
                    </div>

                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left me-1"></i> Voltar ao Catálogo
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-4">
                        <i class="bi bi-pencil-square me-1"></i> Editar Dados
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>